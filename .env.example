# Copy this file to `.env` and fill in your own values.
#   copy .env.example .env      (PowerShell / cmd)
#
# `.env` is git-ignored. Never paste real credentials into any other file,
# into a commit message, or into a chat window.
#
# Where these come from: register a free account at the EPO Developer Portal
# (https://developers.epo.org/), create an app, choose the NON-PAYING access
# level, and copy the app's Consumer Key and Consumer Secret below.

OPS_CONSUMER_KEY=<your-consumer-key>
OPS_CONSUMER_SECRET=<your-consumer-secret>

# Optional. Leave as-is unless the EPO publishes a new API version.
OPS_BASE_URL=https://ops.epo.org/3.2
