# Line endings are pinned here, not by a machine-local core.autocrlf setting,
# so every clone agrees regardless of who configured what.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf

# Never touched as text.
*.png  binary
*.jpg  binary
*.pdf  binary
*.tif  binary
*.sqlite3 binary
