# ---------------------------------------------------------------------------
# Secrets — nothing here may ever enter a commit.
# This block exists before the repo did: .gitignore was written and git init run
# BEFORE any credential file was created, so no key was ever committable.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
credentials.json
secrets.json
token.json

# ---------------------------------------------------------------------------
# Local data and run artifacts (regenerable; see tools/probe_coverage.py)
# ---------------------------------------------------------------------------
var/

# ---------------------------------------------------------------------------
# Build output. Regenerable from packaging/build.ps1, and large: a 50 MB zip in
# git history is 50 MB in every clone forever. Releases carry the binary instead.
# ---------------------------------------------------------------------------
build/
release/

# Superseded files are moved here, never deleted (archive/WHY.md says why each
# one moved). Kept out of the repository: it is a local record, not content.
archive/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
